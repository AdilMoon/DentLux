{
  "title": "PostgreSQL Overview (All Services)",
  "uid": "postgresql-overview-all",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "tags": ["postgres", "database", "monitoring"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "label": "Exporter Job",
        "datasource": "Prometheus",
        "definition": "label_values(pg_up, job)",
        "query": "label_values(pg_up, job)",
        "regex": ".*postgres-exporter.*",
        "multi": true,
        "includeAll": true,
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "PostgreSQL Instances Up",
      "datasource": "Prometheus",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(pg_up{job=~\"$job\"})" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Active Connections",
      "datasource": "Prometheus",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(pg_stat_database_numbackends{job=~\"$job\",datname!~\"template0|template1\"})" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Commits per Second",
      "datasource": "Prometheus",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(pg_stat_database_xact_commit{job=~\"$job\",datname!~\"template0|template1\"}[5m]))" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rollbacks per Second",
      "datasource": "Prometheus",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(pg_stat_database_xact_rollback{job=~\"$job\",datname!~\"template0|template1\"}[5m]))" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Connections by Database",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, datname) (pg_stat_database_numbackends{job=~\"$job\",datname!~\"template0|template1\"})",
          "legendFormat": "{{job}} / {{datname}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Commit Rate by Database",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, datname) (rate(pg_stat_database_xact_commit{job=~\"$job\",datname!~\"template0|template1\"}[5m]))",
          "legendFormat": "{{job}} / {{datname}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Rollback Rate by Database",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, datname) (rate(pg_stat_database_xact_rollback{job=~\"$job\",datname!~\"template0|template1\"}[5m]))",
          "legendFormat": "{{job}} / {{datname}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Deadlocks per Second",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, datname) (rate(pg_stat_database_deadlocks{job=~\"$job\",datname!~\"template0|template1\"}[5m]))",
          "legendFormat": "{{job}} / {{datname}}"
        }
      ]
    }
  ]
}
