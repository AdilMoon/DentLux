// Pipeline: SCM → backend (npm ci + Prisma + tests) → docker compose build
// Jenkins в Docker (compose user: root): перед npm ci ставим make/g++ если образ ещё старый.

pipeline {
  agent any

  environment {
    COMPOSE_PROJECT_NAME = 'dentlux'
    // Сервис db в той же docker-сети, что и jenkins_cicd (см. docker-compose)
    DATABASE_URL = 'postgresql://postgres:12345@db:5432/dentreserve_pro?schema=public&sslmode=no-verify'
  }

  options {
    timestamps()
    ansiColor('xterm')
    disableConcurrentBuilds(abortPrevious: true)
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Backend — install & Prisma') {
      steps {
        sh '''
          export DEBIAN_FRONTEND=noninteractive
          if command -v apt-get >/dev/null 2>&1; then
            apt-get update -qq
            apt-get install -y -qq build-essential python3 python3-dev || true
          fi
          command -v make && make --version | head -1
        '''
        dir('backend') {
          sh 'npm ci'
          sh 'npx prisma validate'
          sh 'npx prisma generate'
        }
      }
    }

    stage('Backend — tests') {
      steps {
        dir('backend') {
          sh 'npm test -- --passWithNoTests'
        }
      }
    }

    stage('Docker — build') {
      steps {
        sh 'docker compose build backend frontend'
      }
    }
  }

  post {
    success {
      sh '''#!/bin/bash
set +e
TOKEN="${TELEGRAM_TOKEN:-}"
CHAT="${TELEGRAM_CHAT_ID:-}"
if [[ -z "$TOKEN" || -z "$CHAT" ]]; then
  echo "Telegram: пропуск (нет TELEGRAM_TOKEN или TELEGRAM_CHAT_ID)"
  exit 0
fi
TEXT="$(printf '%s\n%s' "✅ Jenkins SUCCESS: ${JOB_NAME} #${BUILD_NUMBER}" "${BUILD_URL}")"
curl -sS -m 30 -X POST "https://api.telegram.org/bot${TOKEN}/sendMessage" \
  -d "chat_id=${CHAT}" \
  --data-urlencode "text=${TEXT}" | grep -q '"ok":true' && echo "Telegram: OK (success)" || echo "Telegram: send failed"
'''
    }
    failure {
      sh '''#!/bin/bash
set +e
TOKEN="${TELEGRAM_TOKEN:-}"
CHAT="${TELEGRAM_CHAT_ID:-}"
if [[ -z "$TOKEN" || -z "$CHAT" ]]; then
  echo "Telegram: пропуск (нет TELEGRAM_TOKEN или TELEGRAM_CHAT_ID)"
  exit 0
fi
TEXT="$(printf '%s\n%s' "❌ Jenkins FAILED: ${JOB_NAME} #${BUILD_NUMBER}" "${BUILD_URL}")"
curl -sS -m 30 -X POST "https://api.telegram.org/bot${TOKEN}/sendMessage" \
  -d "chat_id=${CHAT}" \
  --data-urlencode "text=${TEXT}" | grep -q '"ok":true' && echo "Telegram: OK (failure notice)" || echo "Telegram: send failed"
'''
    }
  }
}
