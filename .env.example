# Скопируйте в .env в корне проекта (рядом с docker-compose.yml):
#   cp .env.example .env

GEMINI_API_KEY=

# По умолчанию: gemini-2.5-flash (актуально для v1beta; 1.5 часто 404)
# GEMINI_MODEL=gemini-2.5-flash
# AUTOMATION_SECRET=12345

# SMS при успешной записи на приём (Twilio). Без этих переменных SMS не отправляется.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
